rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helpers — Zero-Trust Multi-Tenant
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Gate multi-tenant: custom claim organizations OU doc de membro.
    //   organizations: { "<orgId>": "admin" | "member" }
    // O lookup em members permite operar sem Cloud Functions.
    function hasClaimAccess(orgId, allowedRoles) {
      return isSignedIn()
        && request.auth.token.organizations is map
        && request.auth.token.organizations.keys().hasAny([orgId])
        && request.auth.token.organizations[orgId] in allowedRoles;
    }

    function memberRole(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role
        : '';
    }

    function hasMemberAccess(orgId, allowedRoles) {
      return isSignedIn() && memberRole(orgId) in allowedRoles;
    }

    function hasOrgAccess(orgId, allowedRoles) {
      return hasClaimAccess(orgId, allowedRoles) || hasMemberAccess(orgId, allowedRoles);
    }

    // Janela de transição: documentos legados sem orgId continuam acessíveis
    // pelo prazo original da regra aberta, para não quebrar o app durante a
    // migração. Depois de 01/10/2026 todo documento precisa ser org-scoped.
    function isTransitionWindow() {
      return request.time < timestamp.date(2026, 10, 1);
    }

    function isOrgScoped(data) {
      return data.keys().hasAll(['orgId']) && data.orgId != null && data.orgId != '';
    }

    // Leitura: admin + member. Escrita: só admin.
    // Documentos legados (sem orgId) seguem a janela de transição.
    function canAccessOrgData(data) {
      return (isOrgScoped(data) && hasOrgAccess(data.orgId, ['admin']))
        || (!isOrgScoped(data) && isTransitionWindow());
    }

    function canReadOrgData(data) {
      return (isOrgScoped(data) && hasOrgAccess(data.orgId, ['admin', 'member']))
        || (!isOrgScoped(data) && isTransitionWindow());
    }

    function canWriteOrgData(data) {
      return (isOrgScoped(data) && hasOrgAccess(data.orgId, ['admin']))
        || (!isOrgScoped(data) && isTransitionWindow());
    }

    // =====================================================================
    // Organizações
    // =====================================================================

    match /organizations/{orgId} {
      allow read: if hasOrgAccess(orgId, ['admin', 'member']);

      // Bootstrap: usuário autenticado pode criar a própria organização.
      // Exige slug + name + createdBy == uid para evitar docs vazios.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.slug is string;

      allow update, delete: if hasOrgAccess(orgId, ['admin']);
    }

    // =====================================================================
    // Membros (subcoleção) — escrita somente admin
    // =====================================================================

    match /organizations/{orgId}/members/{userId} {
      allow read: if hasOrgAccess(orgId, ['admin', 'member']) || isSelf(userId);

      // Escrita somente admin. Exceção: o criador da org pode registrar a si
      // mesmo como admin durante o bootstrap.
      allow create: if (hasOrgAccess(orgId, ['admin'])
        && request.resource.data.role in ['admin', 'member'])
        || (isSelf(userId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'admin'
            && get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid);

      // Admin pode trocar papel; nunca permitir que o último admin saia (validação no client).
      allow update: if hasOrgAccess(orgId, ['admin'])
        && request.resource.data.role in ['admin', 'member'];
      allow delete: if hasOrgAccess(orgId, ['admin']);
    }

    // =====================================================================
    // Convites (subcoleção) — escrita somente admin
    // =====================================================================

    match /organizations/{orgId}/invites/{inviteId} {
      // Admin da org ou o próprio convidado (pelo e-mail do token).
      allow read: if hasOrgAccess(orgId, ['admin'])
        || (isSignedIn()
            && request.auth.token.email != null
            && resource.data.email == request.auth.token.email);

      allow create, update, delete: if hasOrgAccess(orgId, ['admin']);
    }

    // =====================================================================
    // Dados do app — agora org-scoped (players / matches / payments)
    // =====================================================================

    match /players/{playerId} {
      allow read: if canReadOrgData(resource.data);
      allow create: if canWriteOrgData(request.resource.data);
      allow update: if canWriteOrgData(resource.data) && canWriteOrgData(request.resource.data);
      allow delete: if canWriteOrgData(resource.data);
    }

    match /matches/{matchId} {
      allow read: if canReadOrgData(resource.data);
      allow create: if canWriteOrgData(request.resource.data);
      allow update: if canWriteOrgData(resource.data) && canWriteOrgData(request.resource.data);
      allow delete: if canWriteOrgData(resource.data);
    }

    match /payments/{paymentId} {
      allow read: if canReadOrgData(resource.data);
      allow create: if canWriteOrgData(request.resource.data);
      allow update: if canWriteOrgData(resource.data) && canWriteOrgData(request.resource.data);
      allow delete: if canWriteOrgData(resource.data);
    }
  }
}
