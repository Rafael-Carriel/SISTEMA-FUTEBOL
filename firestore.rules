rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helpers — Zero-Trust Multi-Tenant
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Membership documents are the source of truth for each group.
    function memberRole(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role
        : '';
    }

    function hasMemberAccess(orgId, allowedRoles) {
      return isSignedIn() && memberRole(orgId) in allowedRoles;
    }

    function hasOrgAccess(orgId, allowedRoles) {
      return hasMemberAccess(orgId, allowedRoles);
    }

    function isOrgScoped(data) {
      return data.keys().hasAll(['orgId']) && data.orgId != null && data.orgId != '';
    }

    // Leitura: admin + member. Escrita: só admin.
    // Dados sem orgId precisam ser migrados antes de receber acesso.

    function canReadOrgData(data) {
      return isOrgScoped(data) && hasOrgAccess(data.orgId, ['admin', 'member']);
    }

    function canWriteOrgData(data) {
      return isOrgScoped(data) && hasOrgAccess(data.orgId, ['admin']);
    }

    // =====================================================================
    // Organizações
    // =====================================================================

    match /organizations/{orgId} {
      // Leitura liberada p/ logado: necessário p/ checar slug (getDoc)
      // e listar meus futs (list). Dados sensíveis seguem em members/invites.
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Bootstrap: usuário autenticado pode criar a própria organização.
      // Exige slug + name + createdBy == uid para evitar docs vazios.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.slug == orgId
        && request.resource.data.name.size() >= 2
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';

      allow update: if hasOrgAccess(orgId, ['admin'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.slug == resource.data.slug;
      allow delete: if false;
    }

    // =====================================================================
    // Membros (subcoleção) — escrita somente admin
    // =====================================================================

    match /organizations/{orgId}/members/{userId} {
      allow read: if hasOrgAccess(orgId, ['admin', 'member']) || isSelf(userId);

      function validMember() {
        return request.resource.data.userId == userId
          && request.resource.data.orgId == orgId
          && request.resource.data.role in ['admin', 'member'];
      }
      function isOwner() {
        return get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == userId;
      }
      function validCode() {
        let code = request.resource.data.joinCode;
        let invite = get(/databases/$(database)/documents/groupCodes/$(code)).data;
        return invite.orgId == orgId && invite.expiresAt > request.time;
      }
      allow create: if isSignedIn() && validMember() && (
        hasOrgAccess(orgId, ['admin'])
        || (isSelf(userId) && request.resource.data.role == 'admin'
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid)
        || (isSelf(userId) && request.resource.data.role == 'member' && validCode())
      );
      allow update: if hasOrgAccess(orgId, ['admin']) && validMember()
        && (!isOwner() || request.resource.data.role == 'admin');
      allow delete: if hasOrgAccess(orgId, ['admin']) && !isOwner();
    }

    match /organizations/{orgId}/settings/{settingId} {
      allow read, write: if hasOrgAccess(orgId, ['admin']);
    }

    match /groupCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && code.matches('^[A-F0-9]{12}$')
        && request.resource.data.keys().hasOnly(['orgId', 'expiresAt'])
        && hasOrgAccess(request.resource.data.orgId, ['admin'])
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if false;
      allow delete: if hasOrgAccess(resource.data.orgId, ['admin']);
    }

    // =====================================================================
    // Convites (subcoleção) — escrita somente admin
    // =====================================================================

    match /organizations/{orgId}/invites/{inviteId} {
      // Admin da org ou o próprio convidado (pelo e-mail do token).
      allow read: if hasOrgAccess(orgId, ['admin'])
        || (isSignedIn()
            && request.auth.token.email != null
            && resource.data.email == request.auth.token.email);

      allow create, update, delete: if hasOrgAccess(orgId, ['admin']);
    }

    // =====================================================================
    // Dados do app — agora org-scoped (players / matches / payments)
    // =====================================================================

    match /players/{playerId} {
      allow read: if canReadOrgData(resource.data);
      allow create: if canWriteOrgData(request.resource.data);
      allow update: if canWriteOrgData(resource.data) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if canWriteOrgData(resource.data);
    }

    match /matches/{matchId} {
      allow read: if canReadOrgData(resource.data);
      allow create: if canWriteOrgData(request.resource.data);
      allow update: if canWriteOrgData(resource.data) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if canWriteOrgData(resource.data);
    }

    match /payments/{paymentId} {
      allow read: if canReadOrgData(resource.data);
      allow create: if canWriteOrgData(request.resource.data);
      allow update: if canWriteOrgData(resource.data) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if canWriteOrgData(resource.data);
    }
  }
}
